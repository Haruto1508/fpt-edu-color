# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO LÓNG LÁNH (VITE ENVIRONMENT VARIABLES)
# ==============================================================================

# Chế độ bảo trì website (Maintenance Mode):
# - 'true' hoặc '1' : BẬT trang bảo trì (khách truy cập sẽ thấy trang bảo trì)
# - 'false' hoặc để trống : TẮT bảo trì (website hoạt động bình thường)
#
# Mẹo dành cho tác giả / Admin:
# Khi bật bảo trì (trên máy hoặc trên Vercel), bạn vẫn có thể xem trước toàn bộ website bằng cách:
# 1. Truy cập với tham số URL: ?preview=true (Ví dụ: http://localhost:5173/?preview=true)
# 2. Hoặc bấm vào dòng "Dành cho Admin / Tác giả: Mở khóa xem trước website" ở cuối trang bảo trì!
VITE_MAINTENANCE_MODE=false

# ==============================================================================
# CẤU HÌNH LƯU TỪ VÀO GOOGLE SHEETS (KHUYÊN DÙNG CHO GÓC GÓP TỪ)
# ==============================================================================
# URL Webhook lấy từ Google Apps Script (Triển khai dưới dạng Web App):
VITE_GOOGLE_SHEET_API_URL=https://script.google.com/macros/s/AKfycb.../exec

# ==============================================================================
# CẤU HÌNH FIREBASE FIRESTORE (TÙY CHỌN DỰ PHÒNG NẾU DÙNG FIREBASE)
# ==============================================================================
# Lấy các thông số này tại Firebase Console (nếu không dùng Google Sheet):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
